{
  // ══════════════════════════════════════════════════════════════
  //  这是 sing-box-1.14.json 的教学副本
  //  outbounds 换成了占位节点，其余原样。重点看 dns.rules 的注释。
  //
  //  【核心概念】每条规则 = 「如果…就…」
  //      如果 = 条件字段（rule_set / clash_mode / match_response …），可以没有
  //      就   = action，每条都有（不写默认是 route）
  // ══════════════════════════════════════════════════════════════

  "log": {
    "level": "warn",
    "timestamp": true
  },

  "experimental": {
    "cache_file": {
      "enabled": true,
      "store_dns": true
    },

    // clash_api = Clash 兼容的 REST API
    //   external_controller  监听地址。SFM 界面靠它读状态（是否已启动、
    //                        节点分组、连接列表），zashboard 也连它。
    //                        文档：留空则整个 Clash API 关闭。
    //   default_mode         文档原话「本身没有直接作用」，只是给配置里
    //                        那些 clash_mode 规则提供初始值。
    //
    // 这里【没有】external_ui 三件套 —— 见下面 services 处的说明。
    "clash_api": {
      "external_controller": "0.0.0.0:9695",
      "default_mode": "Rule"
    }
  },

  // ══════════════════════════════════════════════════════════════
  //  services —— 配置的第三类顶层组件
  //     inbounds  流量从哪进来
  //     outbounds 流量从哪出去
  //     services  跟代理无关、但要跑起来的后台服务
  //
  //  这里开了【两个】api 服务，各托管一个网页面板：
  //     9696  zashboard
  //     9697  官方 sing-box dashboard
  //
  //  ⚠️ 为什么不用 clash_api 的 external_ui 托管面板（那样只要一个端口）：
  //
  //     clash_api 那段下载代码有 bug（v1.14.0-beta.17 实测）：
  //       · server.go:173       先【同步】下载完外部 UI，才 net.Listen 开端口
  //       · server_resources.go:57  httpClient 只设了 TLSHandshakeTimeout，
  //                             没有整体超时
  //       · 实测：24KB 文件 4 秒下完；6~9MB 的面板永远下不完
  //     后果：clash_api 端口一直不监听 → SFM 界面显示「未启动」、没有
  //     「组」标签，但隧道其实在正常跑（能上网）。这个坑没人报过。
  //
  //     services 的 api 走 1.14 新的 http_client 机制：先开端口、后台
  //     下载，下载慢不影响启动。所以面板改挂这里。
  //
  //  注意这是两套【不同协议】：
  //     clash_api     Clash REST API  ← zashboard 说这个
  //     services api  gRPC            ← 官方 dashboard 说这个
  //  把 zashboard 挂在 api 服务上只是借它当静态文件服务器；zashboard
  //  加载后仍要自己去连 clash_api（9695）。可用 URL 参数预设后端：
  //     http://<ip>:9696/dashboard/#/setup?hostname=<ip>&port=9695
  //
  //  ⚠️ listen 是 0.0.0.0 且 clash_api 没设 secret ——
  //     同网段任何设备都能切你的节点、看连接记录。
  //     文档原话：ALWAYS set a secret if RESTful API is listening on 0.0.0.0
  // ══════════════════════════════════════════════════════════════
  "services": [
    {
      "type": "api",
      "listen": "0.0.0.0",
      "listen_port": 9696,
      "secret": "singbox",
      "dashboard": {
        "enabled": true,
        "path": "zashboard",
        "download_url": "https://gh-proxy.com/https://github.com/Zephyruso/zashboard/archive/refs/heads/gh-pages.zip",
        "http_client": "default",
        "update_interval": "1d"
      }
    },
    {
      "type": "api",
      "listen": "0.0.0.0",
      "listen_port": 9697,
      "secret": "singbox",
      "dashboard": {
        "enabled": true,
        "path": "dashboard",
        "download_url": "https://gh-proxy.com/https://github.com/SagerNet/sing-box-dashboard/archive/refs/heads/gh-pages.zip",
        "http_client": "default",
        "update_interval": "1d"
      }
    }
  ],

  "http_clients": [
    // 所有字段省略，只留名字。展开后等于：
    //   engine=go, version=2(HTTP/2), 无 TLS 覆盖, detour=direct
    //   domain_resolver 继承 route.default_domain_resolver
    //
    // 起作用的不是内容，是【它存在】—— http_clients 非空时，
    // 规则集下载的默认路径从「走默认出站(proxy)」翻成「直连」。
    //
    // 叫 default 是因为它的角色就是默认客户端：route.default_http_client
    // 指向它，任何不指定 http_client 的组件（规则集、面板下载…）都用它。
    { "tag": "default", "detour": "direct" }
  ],

  "dns": {
    // dns-hosts 只负责找到 DoH 服务器自身的 IP，不负责解析普通网站。
    "servers": [
      { "tag": "dns-hosts", "type": "hosts", "predefined": {
        "dns.alidns.com": ["223.5.5.5", "223.6.6.6"],
        "doh.pub": ["1.12.12.21", "120.53.53.53"],
        "dns.google": ["8.8.8.8", "8.8.4.4"]
      } },
      { "tag": "dns-ali", "type": "https", "server": "dns.alidns.com", "domain_resolver": "dns-hosts" },
      { "tag": "dns-pub", "type": "https", "server": "doh.pub", "domain_resolver": "dns-hosts" },
      { "tag": "dns-google", "type": "https", "server": "dns.google", "domain_resolver": "dns-hosts", "detour": "proxy" }
    ],

    // 从上往下匹配。evaluate 会先查询并保存答案，不立即结束；
    // 后面的 respond 会返回先完成的国内 DNS 结果。
    "rules": [
      { "query_type": ["HTTPS", "SVCB"], "action": "predefined", "rcode": "NOERROR" },
      { "clash_mode": "Direct", "action": "route", "server": "dns-ali" },
      { "clash_mode": "Global", "action": "route", "server": "dns-google" },
      { "rule_set": "geosite/category-ads-all", "action": "predefined" },

      // 普通规则下的国内域名：所有查询类型都由阿里和腾讯同时查询，先返回成功响应者。
      // Direct 模式已在上面直接使用 dns-ali，不进入竞速。
      // 不限制 query_type，使 TXT、MX、CNAME 等非地址查询也能竞速。
      { "rule_set": "geosite/cn",
        "action": "evaluate", "server": "dns-ali",
        "tag": "dns-ali-response", "timeout": "3s" },
      { "rule_set": "geosite/cn",
        "action": "evaluate", "server": "dns-pub",
        "tag": "dns-pub-response", "timeout": "3s" },
      { "rule_set": "geosite/cn",
        "match_response": "dns-ali-response", "response_rcode": "NOERROR",
        "action": "respond", "race": true },
      { "rule_set": "geosite/cn",
        "match_response": "dns-pub-response", "response_rcode": "NOERROR",
        "action": "respond", "race": true },

      { "rule_set": "geosite/geolocation-!cn", "action": "route", "server": "dns-google" },
      // 未收录域名：通过代理查询 Google，并附带当前公网 IPv4 的 /24 网段。
      { "query_type": "A", "action": "evaluate", "server": "dns-google",
        "client_subnet": "223.65.16.0/24", "timeout": "2s" },
      { "match_response": true, "rule_set": "geoip/cn", "action": "route", "server": "dns-ali" },
      { "match_response": true, "action": "respond" }
    ],
    "final": "dns-google",
    "optimistic": true,
    "strategy": "ipv4_only",
    "reverse_mapping": true
  },
  "inbounds": [
    {
      "tag": "tun-in",
      "type": "tun",
      "address": ["172.19.0.1/30"],

      // Linux 使用 auto_redirect + 默认 dns_mode: "hijack" 时，DNS 的自动处理流程：
      //
      //   设备 DNS 请求
      //       ↓
      //   auto_redirect 自动重定向到 dns_address
      //       ↓
      //   sing-box 将该地址识别为 hijack-dns
      //       ↓
      //   进入上面的 DNS 模块（dns.rules 再选择具体的上游 DNS）
      //
      // 这部分由 TUN/auto_redirect 自动完成，不依赖 route.rules 中
      // 的 port: 53 规则才能接管。
      //
      // 三种情况要区分：
      //   1. tun-in + auto_redirect：端口 53 由内核自动重定向，
      //      不需要额外的 port: 53 hijack-dns 规则。
      //   2. tun-in + 没有 auto_redirect：端口 53 只是进入 TUN，
      //      需要 route.rules 用 hijack-dns 交给 DNS 模块。
      //   3. mixed-in：请求通过 SOCKS/HTTP 代理入口进入，
      //      没有经过 TUN 的 auto_redirect，也需要 hijack-dns 规则。
      //
      // 因此下面的 route hijack-dns 规则主要服务于第 2、3 种情况；
      // 如果配置只保留 tun-in + auto_redirect，可以删除它。
      //
      // 未显式设置 dns_address 时，sing-box 会使用 address 中第一个
      // IPv4/IPv6 地址的下一个地址作为内部 DNS 接收地址，并自动按
      // hijack-dns 处理。显式设置 dns_address 后，则应配置对应的
      // hijack-dns route 规则。

      // 【不设 mtu】让内核按平台自己选：
      //   Network Extension (SFM/SFI) → 4064
      //   Android                     → 9000
      //   命令行 / 桌面                → 65535
      //
      // 源码注释原文：在 Network Extension 里 MTU 超过 4064 时
      // "the performance of tun will drop significantly"。
      // 原先这里写的 9000 是【安卓的默认值】，抄到 macOS 上
      // 正好绕过了内核的这个保护。

      "auto_route": true,
      "strict_route": false,
      "platform": {
        "http_proxy": { "enabled": true, "server": "127.0.0.1", "server_port": 2080 }
      }
    },
    {
      "tag": "mixed-in",
      "type": "mixed",
      "listen": "127.0.0.1",
      "listen_port": 2080
    }
  ],

  "route": {
    "default_domain_resolver": { "server": "dns-ali" },
    "default_http_client": "default",
    "auto_detect_interface": true,
    "final": "proxy",

    // ────────────────────────────────────────────────────────────
    //  route.rules 和 dns.rules 是【两套独立的规则】
    //    dns.rules   决定「域名交给哪台 DNS 查」
    //    route.rules 决定「连接从哪个出口走」
    //
    //  route 里的 action 和 dns 里的不是同一套：
    //    route         就交给某个出站        → 结束
    //    reject        就掐断这个连接        → 结束
    //    sniff         就嗅探这是什么协议     → 不结束，继续往下
    //    hijack-dns    就把 DNS 请求截下来自己处理
    //    resolve       就把域名解析成 IP      → 不结束
    //    bypass        在 Linux + auto_redirect 的预匹配阶段，
    //                  让连接从内核层面绕过 sing-box
    //    route-options 就只设选项不选出口      → 不结束
    //
    //  bypass 不是普通的 direct：它的特殊作用只发生在
    //  auto_redirect 的预匹配阶段。命中后，内核保存该连接的绕过状态，
    //  后续数据包不再被 auto_redirect 送入 sing-box。
    //  如果 bypass 写了 outbound，但运行在其他场景，行为等同于 route；
    //  不写 outbound 时则只适用于 auto_redirect 的预匹配。
    // ────────────────────────────────────────────────────────────
    "rules": [

      // 没有「如果」→ 所有连接都嗅探一下，看是 HTTP 还是 TLS 还是别的
      // sniff 不结束，继续往下匹配
      { "action": "sniff" },

      // 如果是 DNS 请求 → 就截下来交给上面的 dns 模块处理。
      // 对 tun-in + auto_redirect 的端口 53 流量，这一步通常已经由
      // TUN 的内核自动重定向完成；这里保留 route 规则是为了覆盖：
      //   - 没有 auto_redirect 的 tun-in
      //   - 通过 mixed-in 进入的手动代理请求
      //
      //   两个条件并联（mode: "or"，任一满足即可），各自补对方的盲区：
      //     port 53      抓「嗅探没认出来的」—— 畸形包、不认识的查询类型
      //     protocol dns 抓「不在 53 端口上的」—— 有些软件用 5353 / 1053
      //
      //   protocol 依赖上一条 sniff 的结果（文档原文是 "Sniffed protocol"），
      //   所以 sniff 必须排在它前面。
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          { "port": 53 },
          { "protocol": "dns" }
        ],
        "action": "hijack-dns"
      },

      // 私有地址（局域网、回环等）不经过代理，避免访问软路由和局域网设备异常
      { "ip_is_private": true, "action": "route", "outbound": "direct" },

      // DoT、常见 QUIC 端口、STUN 和已识别的 QUIC 始终拒绝，不受 Direct / Global 绕过
      // 如果满足以下【任意一条】→ 就掐断
      //   logical + mode:or = 「或」，子条件命中一个就算命中
      { 
        "type": "logical",
        "mode": "or",
        "rules": [
          { "port": 853 },                    // DoT 端口
          { "network": "udp", "port": 443 },  // 常见 QUIC / HTTP3 端口
          { "protocol": ["stun", "quic"] } // STUN 或已识别的 QUIC
        ],
        "action": "reject",
        "method": "default",

        //  no_drop: true —— 文档：不启用时，30 秒内触发超过 50 次，
        //  method 会被【临时改成 drop】（静默丢弃）。
        //
        //  那会出问题：浏览器在地址栏打字搜索时，每敲一个字就发一次
        //  搜索建议请求，几秒就把 50 次配额烧光 → 规则转为静默丢弃
        //  → 浏览器收不到「端口不可达」，只能干等 QUIC 握手超时才
        //  回落 TCP → 表现为搜索一直转圈，过 30 秒窗口重置后又好了。
        //
        //  设为 true 后永远快速拒绝，代价是持续回 ICMP 的开销（可忽略）。
        "no_drop": true
      },

      // 如果模式切成「直连」→ 就走直连出口
      { "clash_mode": "Direct", "action": "route", "outbound": "direct" },

      // 如果模式切成「全局」→ 就走代理出口
      { "clash_mode": "Global", "action": "route", "outbound": "proxy" },

      // 如果目标端口是 22 / 3306 / 3307 → 就走直连（SSH 和数据库不走代理）
      { "port": [22, 3306, 3307], "action": "route", "outbound": "direct" },

      // 如果是内网地址 → 就走直连
      { "rule_set": ["geoip/private", "geosite/private"], "action": "route", "outbound": "direct" },

      // 如果是 AI 站点 → 就走 AI 这个分组
      { "rule_set": ["geosite/category-ai-!cn"], "action": "route", "outbound": "AI" },

      // 如果是 YouTube / Google / GitHub → 就走代理
      { "rule_set": ["geosite/youtube", "geoip/google", "geosite/google", "geosite/github"], "action": "route", "outbound": "proxy" },

      // 如果是 Telegram → 就走代理
      { "rule_set": ["geoip/telegram", "geosite/telegram"], "action": "route", "outbound": "proxy" },

      // 如果在国外网站名单里 → 就走代理
      { "rule_set": "geosite/geolocation-!cn", "action": "route", "outbound": "proxy" },

      // 如果在国内名单里 → 就走直连
      { "rule_set": ["geosite/cn", "geoip/cn"], "action": "route", "outbound": "direct" }

      // 以上都没命中 → 用下面的 "final": "proxy" 兜底，走代理
    ],

    // ── 规则集：上面 rule_set 引用的名单文件，启动时从网上下载 ──
    //
    //  1.14 起 tag 可以是数组，url 里的 {tag} 会被每个 tag 逐个替换，
    //  展开成多个独立的规则集。所以原来 13 条声明压成了 1 条。
    //
    //  注意 tag 里的 "geosite/" "geoip/" 前缀，它一举两得：
    //    ① 它同时是 URL 路径的一部分 —— {tag} 替换后正好拼出
    //       .../geo/geosite/cn.srs
    //    ② tag 在全局必须唯一，而 geosite 和 geoip 下有 4 组同名文件
    //       （cn / google / telegram / private），靠前缀区分开
    //
    //  所以前缀【不能】挪到 url 里去写成两条 —— 那样展开后会出现两个
    //  都叫 "cn" 的规则集，启动直接报 duplicate rule-set tag。
    //
    //  引用时用带斜杠的全名 "geosite/cn"，不是旧的 "geosite/cn"
    "rule_set": [
      {
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/{tag}.srs",
        "tag": [
          "geosite/category-ads-all", "geosite/category-ai-!cn", "geosite/cn",
          "geosite/geolocation-!cn",  "geosite/github",          "geosite/google",
          "geosite/private",          "geosite/telegram",        "geosite/youtube",
          "geoip/cn",                 "geoip/google",            "geoip/private",
          "geoip/telegram"
        ]
      }
    ]
  },

  // ══════════════════════════════════════════════════════════════
  //  以下是占位节点，替换了原来的 个真实节点
  //  只保留了被上面规则引用到的三个 tag：direct / proxy / AI
  // ══════════════════════════════════════════════════════════════
  "outbounds": [
    { "type": "direct", "tag": "direct", "domain_resolver": "dns-ali" },

    { 
      "type": "vless",
      "tag": "节点A",
      "server": "example.com",
      "server_port": 443,
      "uuid": "00000000-0000-0000-0000-000000000000",
      "tls": { "enabled": true }
    },

    { "type": "selector", "tag": "proxy", "outbounds": ["节点A"] },
    { "type": "selector", "tag": "AI",    "outbounds": ["节点A"] }
  ]
}
