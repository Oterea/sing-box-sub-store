{
    "log": {
        "disabled": false,
        "level": "warn",
        "timestamp": true
    },
    "experimental": {
        "cache_file": {
            "enabled": true,
            "store_dns": true
        },
        "clash_api": {
            "external_controller": "127.0.0.1:9695",
            "default_mode": "Rule"
        }
    },
    "services": [
        {
            "type": "api",
            "listen": "127.0.0.1",
            "listen_port": 9696,
            "secret": "singbox",
            "dashboard": {
                "enabled": true,
                "path": "zashboard",
                "download_url": "https://gh-proxy.com/https://github.com/Zephyruso/zashboard/archive/refs/heads/gh-pages.zip",
                "http_client": "default",
                "update_interval": "1d"
            }
        },
        {
            "type": "api",
            "listen": "127.0.0.1",
            "listen_port": 9697,
            "secret": "singbox",
            "dashboard": {
                "enabled": true,
                "path": "dashboard",
                "download_url": "https://gh-proxy.com/https://github.com/SagerNet/sing-box-dashboard/archive/refs/heads/gh-pages.zip",
                "http_client": "default",
                "update_interval": "1d"
            }
        }
    ],
    "http_clients": [
        {
            "tag": "default",
            "detour": "direct"
        }
    ],
    "dns": {
        "servers": [
            {
                "tag": "dns-hosts",
                "type": "hosts",
                "predefined": {
                    "dns.alidns.com": ["223.5.5.5", "223.6.6.6"],
                    "doh.pub": ["1.12.12.21", "120.53.53.53"],
                    "dns.google": ["8.8.8.8", "8.8.4.4"]
                }
            },
            {
                "tag": "dns-ali",
                "type": "https",
                "server": "dns.alidns.com",
                "domain_resolver": "dns-hosts"
            },
            {
                "tag": "dns-pub",
                "type": "https",
                "server": "doh.pub",
                "domain_resolver": "dns-hosts"
            },
            {
                "tag": "dns-google",
                "type": "https",
                "server": "dns.google",
                "domain_resolver": "dns-hosts",
                "detour": "proxy"
            }
        ],
        "rules": [
            {
                "query_type": ["HTTPS", "SVCB"],
                "action": "predefined",
                "rcode": "NOERROR"
            },
            {
                "clash_mode": "Direct",
                "action": "route",
                "server": "dns-ali"
            },
            {
                "clash_mode": "Global",
                "action": "route",
                "server": "dns-google"
            },
            {
                "rule_set": "geosite/category-ads-all",
                "action": "predefined"
            },
            {
                "rule_set": "geosite/cn",
                "action": "evaluate",
                "server": "dns-ali",
                "tag": "dns-ali-response",
                "timeout": "3s"
            },
            {
                "rule_set": "geosite/cn",
                "action": "evaluate",
                "server": "dns-pub",
                "tag": "dns-pub-response",
                "timeout": "3s"
            },
            {
                "rule_set": "geosite/cn",
                "match_response": "dns-ali-response",
                "response_rcode": "NOERROR",
                "action": "respond",
                "race": true
            },
            {
                "rule_set": "geosite/cn",
                "match_response": "dns-pub-response",
                "response_rcode": "NOERROR",
                "action": "respond",
                "race": true
            },
            {
                "rule_set": "geosite/geolocation-!cn",
                "action": "route",
                "server": "dns-google"
            },
            {
                "query_type": "A",
                "action": "evaluate",
                "server": "dns-google",
                "client_subnet": "223.65.16.0/24",
                "timeout": "2s"
            },
            {
                "match_response": true,
                "rule_set": "geoip/cn",
                "action": "route",
                "server": "dns-ali"
            },
            {
                "match_response": true,
                "action": "respond"
            }
        ],
        "final": "dns-google",
        "optimistic": true,
        "strategy": "ipv4_only",
        "reverse_mapping": true
    },
    "inbounds": [
        {
            "tag": "tun-in",
            "type": "tun",
            "address": [
                "198.18.0.1/30"
            ],
            "auto_route": true,
            "auto_redirect": true,
            "strict_route": false
        },
        {
            "tag": "mixed-in",
            "type": "mixed",
            "listen": "0.0.0.0",
            "listen_port": 7890
        }
    ],
    "route": {
        "default_domain_resolver": {
            "server": "dns-ali"
        },
        "default_http_client": "default",
        "auto_detect_interface": true,
        "final": "proxy",
        "rules": [
            {
                "type": "logical",
                "mode": "and",
                "rules": [
                    {
                        "port": 853,
                        "invert": true
                    },
                    {
                        "clash_mode": "Global",
                        "invert": true
                    },
                    {
                        "type": "logical",
                        "mode": "or",
                        "rules": [
                            {
                                "ip_is_private": true
                            },
                            {
                                "rule_set": "geoip/cn"
                            }
                        ]
                    }
                ],
                "action": "bypass"
            },
            {
                "action": "sniff"
            },
            {
                "type": "logical",
                "mode": "or",
                "rules": [
                    {
                        "port": 53
                    },
                    {
                        "protocol": "dns"
                    }
                ],
                "action": "hijack-dns"
            },
            {
                "ip_is_private": true,
                "action": "route",
                "outbound": "direct"
            },
            {
                "type": "logical",
                "mode": "or",
                "rules": [
                    {
                        "port": 853
                    },
                    {
                        "network": "udp",
                        "port": 443
                    },
                    {
                        "protocol": ["stun", "quic"]
                    }
                ],
                "action": "reject",
                "method": "default",
                "no_drop": true
            },
            {
                "clash_mode": "Direct",
                "action": "route",
                "outbound": "direct"
            },
            {
                "clash_mode": "Global",
                "action": "route",
                "outbound": "proxy"
            },
            {
                "rule_set": "geosite/private",
                "action": "route",
                "outbound": "direct"
            },
            {
                "rule_set": [
                    "geosite/category-ai-!cn"
                ],
                "action": "route",
                "outbound": "AI"
            },
            {
                "rule_set": [
                    "geosite/youtube",
                    "geosite/google",
                    "geosite/github",
                    "geosite/telegram"
                ],
                "action": "route",
                "outbound": "proxy"
            },
            {
                "rule_set": "geosite/cn",
                "action": "route",
                "outbound": "direct"
            },
            {
                "rule_set": "geosite/geolocation-!cn",
                "action": "route",
                "outbound": "proxy"
            },
            {
                "inbound": "mixed-in",
                "action": "resolve"
            },
            {
                "rule_set": "geoip/telegram",
                "action": "route",
                "outbound": "proxy"
            },
            {
                "rule_set": "geoip/cn",
                "action": "route",
                "outbound": "direct"
            }
        ],
        "rule_set": [
            {
                "type": "remote",
                "format": "binary",
                "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/{tag}.srs",
                "tag": [
                    "geosite/category-ads-all",
                    "geosite/category-ai-!cn",
                    "geosite/cn",
                    "geosite/geolocation-!cn",
                    "geosite/github",
                    "geosite/google",
                    "geosite/private",
                    "geosite/telegram",
                    "geosite/youtube",
                    "geoip/cn",
                    "geoip/telegram"
                ]
            }
        ]
    },
    "outbounds": [
        {
            "type": "direct",
            "tag": "direct",
            "domain_resolver": "dns-ali"
        }
    ]
}
